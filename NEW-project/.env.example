# CYPHER environment example
# Copy this file to .env and fill in real values.

NODE_ENV=development

# Server ports
NODE_PORT=8082
NGINX_PORT=8443
# PORT overrides NODE_PORT for direct Node test runs when set.
PORT=
HOST=127.0.0.1

# Qwen / DashScope API Key
# DASHSCOPE_API_KEY is Aliyun DashScope's API key, used by Qwen/Qwen-VL calls.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-vl-plus
DASHSCOPE_MODEL=

# YOLO models
CYPHER_YOLO_MODEL=
CYPHER_YOLO_PPE_MODEL=
CYPHER_YOLO_FIRE_MODEL=

# YOLO safety skill defaults
CYPHER_YOLO_CONF_DEFAULT=0.35
CYPHER_YOLO_CONF_NO_HELMET=0.55
CYPHER_YOLO_CONF_NO_VEST=0.55
CYPHER_YOLO_CONF_FIRE=0.50
CYPHER_YOLO_CONF_SMOKE=0.50
CYPHER_ALERT_CONFIRM_NO_HELMET=3
CYPHER_ALERT_CONFIRM_NO_VEST=3
CYPHER_ALERT_CONFIRM_FIRE=2
CYPHER_ALERT_CONFIRM_SMOKE=2
CYPHER_ALERT_COOLDOWN_SECONDS=5
CYPHER_FIRE_ALERT_COOLDOWN_SECONDS=10
CYPHER_ENABLE_QWEN_REVIEW=false

# Paths
RECORDINGS_DIR=recordings
FFMPEG_PATH=

# Optional default camera source. Do not put real passwords in shared examples.
DEFAULT_RTSP_URL=
DEFAULT_RTSP_LABEL=Default RTSP Camera

# RTSP preview performance
RTSP_TRANSPORT=tcp
RTSP_WIDTH=1280
RTSP_HEIGHT=720
RTSP_FPS=25
RTSP_JPEG_QUALITY=80
RTSP_MJPEG_MAX_BUFFER_MB=8
MJPEG_DEFAULT_FPS=25

# WeChat Work Webhook URL (for enterprise WeChat push notifications)
# Get this from your WeChat Work group bot settings
WECHAT_WEBHOOK_URL=
